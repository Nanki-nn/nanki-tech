# ===== 站点访问的 OSS 基础地址 =====
# 构建时会把这两个变量内联进前端产物，所以必须以 NEXT_PUBLIC_ 开头。
# 图片引用保持 key 形式（例如 /blog-assets/tool-calling/1.png），
# 最终 URL = NEXT_PUBLIC_OSS_BASE_URL / NEXT_PUBLIC_OSS_DIR_PREFIX / key
#
# 不设置时使用代码里的默认值（见 src/lib/assets.ts），即：
#   https://aisoftoj.oss-cn-beijing.aliyuncs.com/aisoftoj
NEXT_PUBLIC_OSS_BASE_URL=https://aisoftoj.oss-cn-beijing.aliyuncs.com
NEXT_PUBLIC_OSS_DIR_PREFIX=aisoftoj

# ===== 上传凭据（只在本地/CI 执行 npm run oss:sync 时需要，不会进前端产物）=====
# 建议使用只对该桶有写权限的最小权限账号，切勿提交真实密钥。
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=aisoftoj
# 与 NEXT_PUBLIC_OSS_BASE_URL 保持一致，用于校验并打印最终可访问地址。
OSS_BASE_URL=https://aisoftoj.oss-cn-beijing.aliyuncs.com
# 上传到桶内的目录前缀，末尾斜杠可省略。
OSS_DIR_PREFIX=aisoftoj
